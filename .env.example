# AquaRoute secrets — copy to `.env` and fill in. NEVER commit the real .env.
# All values are for FREE APIs (free key or free account). See §4 of the brief.

# --- Database (PostGIS via docker-compose) ---
POSTGRES_USER=aquaroute
POSTGRES_PASSWORD=aquaroute
POSTGRES_DB=aquaroute
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLAlchemy URL (leave as-is to derive from the parts above)
DATABASE_URL=postgresql+psycopg://aquaroute:aquaroute@localhost:5432/aquaroute

# --- OpenTopography (DEM) — free key: https://portal.opentopography.org/ ---
OPENTOPOGRAPHY_API_KEY=

# --- Google Earth Engine (SAR flood labels) — free research account ---
# Run `earthengine authenticate` once, then set the cloud project id here.
EE_PROJECT=

# --- TomTom Traffic (calibration ground-truth, optional) — free tier ---
# If empty, the pipeline uses the synthetic traffic generator instead.
TOMTOM_API_KEY=

# --- OpenRouteService (routing fallback, optional) — free key ---
ORS_API_KEY=

# --- Nominatim usage: identify yourself per OSM policy (1 req/s) ---
NOMINATIM_USER_AGENT=aquaroute-dev
